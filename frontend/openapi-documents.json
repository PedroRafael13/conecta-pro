    "/api/v1/documents/{document_id}/ocr": {
      "post": {
        "tags": [
          "Document Intelligence"
        ],
        "summary": "Executar OCR em documento",
        "description": "Executa OCR em um documento.\n\n- **document_id**: ID do documento\n- **provider**: Provider de OCR (tesseract, easyocr, google_vision)\n- **languages**: Lista de idiomas para OCR",
        "operationId": "run_ocr_api_v1_documents__document_id__ocr_post",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Provider de OCR",
              "default": "tesseract",
              "title": "Provider"
            },
            "description": "Provider de OCR"
          },
          {
            "name": "languages",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Idiomas (separados por virgula)",
              "default": "por,eng",
              "title": "Languages"
            },
            "description": "Idiomas (separados por virgula)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {

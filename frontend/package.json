    "test:e2e:monitoring": "playwright test e2e/monitoring-*.spec.ts",
    "test:e2e:notifications": "playwright test e2e/notifications-*.spec.ts",
    "test:e2e:operacional": "playwright test e2e/operacional-*.spec.ts --project=chromium-no-auth",
    "test:e2e:recruitment": "playwright test e2e/recruitment-*.spec.ts",
    "test:e2e:reimbursement": "playwright test e2e/reimbursement-*.spec.ts",
    "test:e2e:reports": "playwright test e2e/reports-*.spec.ts",
    "test:e2e:retention": "playwright test e2e/retention-*.spec.ts",

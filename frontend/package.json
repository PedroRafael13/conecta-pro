{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:build": "npm run build && npx cap sync",
    "cap:android": "npm run cap:build && npx cap open android",
    "cap:ios": "npm run cap:build && npx cap open ios",
    "cap:android:run": "npm run cap:build && npx cap run android",
    "cap:ios:run": "npm run cap:build && npx cap run ios",
    "cap:assets": "npx capacitor-assets generate --iconBackgroundColor '#0A2540' --splashBackgroundColor '#0A2540'"
  },

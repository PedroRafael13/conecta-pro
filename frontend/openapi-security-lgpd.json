{
  "openapi": "3.1.0",
  "info": {
    "title": "Conecta PRO - LGPD Security API",
    "version": "1.0.0",
    "description": "API de Segurança e Compliance LGPD - Lei 13.709/2018\n\nMódulo completo de proteção de dados conforme LGPD:\n- Gestão de Consentimentos (Art. 7, 8 e 9)\n- Criptografia e Mascaramento de Dados Sensíveis\n- Direito ao Esquecimento (Art. 18)\n- Avaliação de Impacto de Privacidade (PIA/DPIA - Art. 38)\n- Trilha de Auditoria com Hash Chain (Art. 46)\n- Controle DPO e Incidentes de Segurança"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Servidor de Desenvolvimento"
    },
    {
      "url": "https://api.conectapro.com.br",
      "description": "Servidor de Produção"
    }
  ],
  "paths": {
    "/lgpd/consent/register": {
      "post": {
        "tags": ["LGPD - Consentimento"],
        "summary": "Registra consentimento LGPD",
        "description": "Registra consentimento do titular conforme Art. 7 LGPD.",
        "operationId": "registerConsent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Consentimento registrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "400": {
            "description": "Erro de validação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/lgpd/consent/{titular_id}": {
      "get": {
        "tags": ["LGPD - Consentimento"],
        "summary": "Consulta consentimentos de titular",
        "description": "Retorna todos os consentimentos de um titular.",
        "operationId": "getConsents",
        "parameters": [
          {
            "name": "titular_id",
            "in": "path",
            "required": true,
            "description": "UUID do titular",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de consentimentos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/lgpd/consent/{consent_id}/revoke": {
      "delete": {
        "tags": ["LGPD - Consentimento"],
        "summary": "Revoga consentimento",
        "description": "Revoga um consentimento específico.",
        "operationId": "revokeConsent",

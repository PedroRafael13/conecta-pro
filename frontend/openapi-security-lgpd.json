              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StandardResponse": {
        "type": "object",
        "required": ["success", "message"],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indica se a operação foi bem-sucedida"
          },
          "message": {
            "type": "string",
            "description": "Mensagem descritiva do resultado"
          },
          "data": {
            "type": "object",
            "description": "Dados retornados pela operação",
            "additionalProperties": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["detail"],
        "properties": {
          "detail": {
            "type": "string",
            "description": "Mensagem de erro detalhada"
          }
        }
      },
      "ConsentRequest": {
        "type": "object",
        "required": ["titular_id", "titular_email", "purpose", "legal_basis"],
        "properties": {
          "titular_id": {
            "type": "string",
            "format": "uuid",
            "description": "UUID do titular dos dados"
          },
          "titular_email": {
            "type": "string",
            "format": "email",
            "description": "Email do titular"
          },
          "purpose": {
            "type": "string",
            "description": "Finalidade do consentimento"
          },
          "legal_basis": {
            "type": "string",
            "description": "Base legal LGPD"
          },
          "description": {
            "type": "string",
            "description": "Descrição detalhada do consentimento"
          },
          "expiration_days": {
            "type": "integer",
            "description": "Dias até expiração",
            "default": 365
          }
        }
      },
      "EncryptDataRequest": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "string",
            "description": "Dados a serem criptografados"
          },
          "algorithm": {
            "type": "string",
            "description": "Algoritmo de criptografia",
            "enum": ["AES-256-GCM", "AES-256-CBC", "Fernet", "ChaCha20-Poly1305", "RSA-OAEP"],
            "default": "AES-256-GCM"
          },
          "key_id": {
            "type": "string",
            "description": "ID da chave (opcional)"
          }
        }
      },
      "DecryptDataRequest": {
        "type": "object",
        "required": ["encrypted_data"],
        "properties": {
          "encrypted_data": {
            "type": "string",
            "description": "Dados criptografados em base64"
          },
          "key_id": {
            "type": "string",
            "description": "ID da chave"
          }
        }
      },
      "AuditLogRequest": {
        "type": "object",
        "required": ["action", "resource_type", "resource_id", "user_id"],
        "properties": {
          "action": {
            "type": "string",
            "description": "Ação realizada"
          },
          "resource_type": {
            "type": "string",

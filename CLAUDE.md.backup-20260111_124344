│   │   ├── government_integrations/  # eSocial, SEFAZ, Receita
│   │   ├── health_occupational/      # PCMSO, PPRA, EPI (NRs)
│   │   ├── hr/           # RH, folha, ponto
│   │   ├── integrations/ # API gateway, webhooks
│   │   ├── operations/   # Postos, escalas, turnos

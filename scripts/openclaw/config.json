{
  "project_root": "/opt/conecta-pro",
  "cycle_interval_seconds": 3600,
  "checks": {
    "backend_tests": {
      "enabled": true,
      "timeout": 120
    },
    "frontend_tests": {
      "enabled": true,
      "timeout": 120
    },
    "e2e_tests": {
      "enabled": true,
      "timeout": 300
    },
    "backend_lint": {
      "enabled": true,
      "timeout": 60
    },
    "frontend_lint": {
      "enabled": true,
      "timeout": 60
    },
    "security_bandit": {
      "enabled": true,
      "timeout": 60
    },
    "coverage": {
      "enabled": true,
      "timeout": 180,
      "min_coverage": 60
    },
    "health": {
      "enabled": true,
      "timeout": 30
    },
    "docker_status": {
      "enabled": true,
      "timeout": 15
    },
    "disk_space": {
      "enabled": true,
      "timeout": 5,
      "min_free_gb": 5
    },
    "lighthouse": {
      "enabled": false,
      "timeout": 120
    }
  },
  "notifications": {
    "discord_webhook": "",
    "slack_webhook": "",
    "notify_on": ["fail", "error"]
  },
  "retention": {
    "reports_days": 30,
    "logs_days": 14
  }
}
